<?xml version="1.0"?>
<simulation>
  <project id="lih_external_lcao_ecp" series="0"><parameter name="driver_version">batch</parameter></project>
  <random seed="81357"/>
  <!-- Fixed captured orbitals from the existing LiH_pp asset; only four J2 variables are active. -->
  <particleset name="ion0" size="2">
    <group name="Li"><parameter name="charge">1</parameter><parameter name="valence">1</parameter>
      <parameter name="atomicnumber">3</parameter></group>
    <group name="H"><parameter name="charge">1</parameter><parameter name="valence">1</parameter>
      <parameter name="atomicnumber">1</parameter></group>
    <attrib name="position" datatype="posArray">0 0 0  0 0 3.0139239778</attrib>
    <attrib name="ionid" datatype="stringArray">Li H</attrib>
  </particleset>
  <particleset name="e">
    <group name="u" size="1"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
      <attrib name="position" datatype="posArray">0.2 -0.3 0.4</attrib></group>
    <group name="d" size="1"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
      <attrib name="position" datatype="posArray">-0.5 0.1 0.7</attrib></group>
  </particleset>
  <wavefunction name="psi0" target="e" print_parameters="no">
    <sposet_collection type="MolecularOrbital" name="LCAOBSet" source="ion0" transform="yes"
                       href="LiH.orbs.h5" source_identity="file_image" source_identity_max_bytes="1048576">
      <sposet name="spo-ud" size="1" optimize="no">
        <occupation mode="ground"/><coefficient size="62" spindataset="0"/>
      </sposet>
    </sposet_collection>
    <determinantset><slaterdeterminant>
      <determinant sposet="spo-ud"/><determinant sposet="spo-ud"/>
    </slaterdeterminant></determinantset>
    <jastrow name="J2" type="Two-Body" function="Bspline">
      <correlation rcut="4" size="4" speciesA="u" speciesB="d">
        <coefficients id="ud" type="Array" optimize="yes">0.12 -0.08 0.04 -0.01</coefficients>
      </correlation>
    </jastrow>
  </wavefunction>
  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e"/>
    <constant name="IonIon" type="coulomb" source="ion0" target="ion0"/>
    <pairpot name="PseudoPot" type="pseudo" source="ion0" wavefunction="psi0"
             format="xml" algorithm="batched" DLA="no" pbc="no">
      <pseudo elementType="Li" href="Li.BFD.xml" format="xml" nrule="2" l-local="1"/>
      <pseudo elementType="H" href="H.BFD.xml" format="xml" nrule="2" l-local="0"/>
    </pairpot>
  </hamiltonian>
  <qmc method="wf_train" move="pbyp" checkpoint="1">
    <training objective="energy" optimizer="adam">
      <parameter name="iterations">2</parameter><parameter name="learning_rate">0.0001</parameter>
      <parameter name="parameter_chunk_size">4</parameter><parameter name="legacy_maximum_parameters">64</parameter>
      <parameter name="legacy_derivative_scratch_bytes">65536</parameter>
      <parameter name="checkpoint_interval">1</parameter><parameter name="line_search">off</parameter>
    </training>
    <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
    <parameter name="blocks">2</parameter><parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
    <parameter name="timestep">0.0001</parameter><parameter name="usedrift">no</parameter>
    <inference interval="1" last="yes" move="pbyp">
      <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
      <parameter name="blocks">1</parameter><parameter name="steps">1</parameter>
      <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
      <parameter name="timestep">0.0001</parameter><parameter name="usedrift">no</parameter>
    </inference>
  </qmc>
</simulation>
