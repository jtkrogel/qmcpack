<?xml version="1.0"?>
<simulation>
  <project id="h2_psiformer_optimizers" series="0">
    <parameter name="driver_version">batch</parameter>
  </project>
  <random seed="81357"/>

  <particleset name="ion0" size="2">
    <group name="H">
      <parameter name="charge">1</parameter>
      <parameter name="valence">1</parameter>
      <parameter name="atomicnumber">1</parameter>
    </group>
    <attrib name="position" datatype="posArray">
      0.0 0.0 -0.7
      0.0 0.0  0.7
    </attrib>
  </particleset>

  <particleset name="e" random="yes" randomsrc="ion0">
    <group name="u" size="1"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter></group>
    <group name="d" size="1"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter></group>
  </particleset>

  <wavefunction name="psi0" target="e">
    <psiformer name="pf" initialization="deepqmc_psiformer_v1"
               initialization_seed="29" source="ion0" system="all_electron"
               optimize="yes" optimize_scope="indices" optimize_indices="0"/>
  </wavefunction>

  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e"/>
    <pairpot name="IonElec" type="coulomb" source="ion0" target="e"/>
    <constant name="IonIon" type="coulomb" source="ion0" target="ion0"/>
  </hamiltonian>

  <qmc method="wf_train" move="pbyp" checkpoint="-1">
    <training objective="energy" optimizer="sr" learning_rate="1e-10" damping="1e-2"
              krylov_maximum_iterations="4" krylov_maximum_operator_applications="6"/>
    <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
    <parameter name="blocks">1</parameter><parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
    <parameter name="timestep">1e-4</parameter><parameter name="usedrift">no</parameter>
  </qmc>
  <qmc method="wf_train" move="pbyp" checkpoint="-1">
    <training objective="energy" optimizer="minsr" learning_rate="1e-10" damping="1e-2"
              krylov_maximum_iterations="4" krylov_maximum_operator_applications="6"/>
    <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
    <parameter name="blocks">1</parameter><parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
    <parameter name="timestep">1e-4</parameter><parameter name="usedrift">no</parameter>
  </qmc>
  <qmc method="wf_train" move="pbyp" checkpoint="-1">
    <training objective="energy" optimizer="spring" learning_rate="1e-10" damping="1e-2"
              krylov_maximum_iterations="4" krylov_maximum_operator_applications="6"
              spring_history_decay="0.99" spring_maximum_update_norm_squared="1e-4"/>
    <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
    <parameter name="blocks">1</parameter><parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
    <parameter name="timestep">1e-4</parameter><parameter name="usedrift">no</parameter>
  </qmc>
</simulation>
