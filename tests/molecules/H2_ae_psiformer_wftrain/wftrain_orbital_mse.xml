<?xml version="1.0"?>
<!-- Self-contained orbital pretraining: a conventional Gaussian Slater teacher,
     not teacher-amplitude fitting or an imported neural parameter checkpoint. -->
<simulation>
  <project id="h2_psiformer_orbital_mse" series="0">
    <parameter name="driver_version">batch</parameter>
  </project>
  <random seed="81357"/>
  <particleset name="ion0" size="2">
    <group name="H">
      <parameter name="charge">1</parameter>
      <parameter name="valence">1</parameter>
      <parameter name="atomicnumber">1</parameter>
    </group>
    <attrib name="position" datatype="posArray">0 0 -0.7  0 0 0.7</attrib>
  </particleset>
  <particleset name="e" random="yes" randomsrc="ion0">
    <group name="u" size="1"><parameter name="charge">-1</parameter></group>
    <group name="d" size="1"><parameter name="charge">-1</parameter></group>
  </particleset>
  <wavefunction name="student" target="e" print_parameters="no">
    <psiformer name="student_pf" initialization="deepqmc_psiformer_v1"
               initialization_seed="29" source="ion0" system="all_electron"
               gpu="cpu" optimize="yes" optimize_scope="indices" optimize_indices="1"/>
  </wavefunction>
  <wavefunction name="teacher" target="e">
    <sposet_collection name="gaussian" type="MolecularOrbital" source="ion0" transform="no">
      <basisset name="gaussian" keyword="GTO">
        <atomicBasisSet name="H" angular="cartesian" type="Gaussian"
                        elementType="H" normalized="no">
          <basisGroup rid="H1s" n="0" l="0" type="Gaussian">
            <radfunc exponent="1.0" contraction="1.0"/>
          </basisGroup>
        </atomicBasisSet>
      </basisset>
      <sposet name="occupied" basisset="gaussian" size="1">
        <occupation mode="ground"/>
        <coefficient size="1">0.7071067811865475 0.7071067811865475</coefficient>
      </sposet>
    </sposet_collection>
    <determinantset>
      <slaterdeterminant>
        <determinant sposet="occupied"/>
        <determinant sposet="occupied"/>
      </slaterdeterminant>
    </determinantset>
  </wavefunction>
  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e"/>
    <pairpot name="IonElec" type="coulomb" source="ion0" target="e"/>
    <constant name="IonIon" type="coulomb" source="ion0" target="ion0"/>
  </hamiltonian>
  <qmc method="wf_train" move="pbyp" checkpoint="-1">
    <qmcsystem wavefunction="student" hamiltonian="h0" source="ion0"/>
    <training objective="orbital_mse" optimizer="adam">
      <parameter name="iterations">2</parameter>
      <parameter name="teacher">teacher</parameter>
      <parameter name="target_provenance">inline-h2-gaussian-exponent-1-v1</parameter>
      <parameter name="orbital_target">single_reference</parameter>
      <parameter name="learning_rate">1e-8</parameter>
      <parameter name="parameter_chunk_size">4096</parameter>
    </training>
    <parameter name="walkers_per_rank">2</parameter>
    <parameter name="crowds">1</parameter>
    <parameter name="blocks">1</parameter>
    <parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter>
    <parameter name="substeps">1</parameter>
    <parameter name="timestep">1e-4</parameter>
    <parameter name="usedrift">no</parameter>
  </qmc>
</simulation>
