<?xml version="1.0"?>
<simulation>
  <project id="be_conventional_mdj_ecp" series="0"><parameter name="driver_version">batch</parameter></project>
  <random seed="81357"/>
  <!-- Fixed s/px DETS and active J2; ordinary-locality Be BFD, not all-electron.
       Exact virtual nodes are covered by the separate accepted-reference unit. -->
  <particleset name="ion0" size="1">
    <group name="Be"><parameter name="charge">2</parameter><parameter name="valence">2</parameter>
      <parameter name="atomicnumber">4</parameter></group>
    <attrib name="position" datatype="posArray">0 0 0</attrib>
  </particleset>
  <particleset name="e">
    <group name="u" size="1"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
      <attrib name="position" datatype="posArray">0.2 -0.3 0.4</attrib></group>
    <group name="d" size="1"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
      <attrib name="position" datatype="posArray">-0.5 0.1 0.7</attrib></group>
  </particleset>
  <wavefunction name="psi0" target="e" print_parameters="no">
    <sposet_collection type="MolecularOrbital" source="ion0">
      <basisset keyword="STO" transform="no">
        <atomicBasisSet type="STO" elementType="Be" angular="cartesian" normalized="no">
          <basisGroup rid="S" n="1" l="0" m="0" type="Slater"><radfunc n="1" exponent="1.2"/></basisGroup>
          <basisGroup rid="P" n="2" l="1" type="Slater"><radfunc n="2" exponent="1.2"/></basisGroup>
        </atomicBasisSet>
      </basisset>
      <sposet name="fixed" size="2" optimize="no">
        <coefficient size="2" id="fixed_orbitals">1 0 0 0  0 1 0 0</coefficient>
      </sposet>
    </sposet_collection>
    <determinantset>
      <multideterminant optimize="yes" spo_0="fixed" spo_1="fixed" algorithm="precomputed_table_method">
        <detlist size="2" type="DETS" nc0="0" nc1="0" ne0="1" ne1="1" nstates="2" cutoff="0">
          <ci id="CI0" coeff="0.6" occ0="10" occ1="10"/>
          <ci id="CI1" coeff="0.05" occ0="01" occ1="01"/>
        </detlist>
      </multideterminant>
    </determinantset>
    <jastrow name="J2" type="Two-Body" function="Bspline">
      <correlation rcut="4" size="4" speciesA="u" speciesB="d">
        <coefficients id="ud" type="Array" optimize="yes">0.12 -0.08 0.04 -0.01</coefficients>
      </correlation>
    </jastrow>
  </wavefunction>
  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e"/>
    <pairpot name="PseudoPot" type="pseudo" source="ion0" wavefunction="psi0"
             format="xml" algorithm="batched" DLA="no" pbc="no">
      <pseudo elementType="Be" href="../../pseudopotentials_for_tests/Be.BFD.xml" format="xml" nrule="2" l-local="1"/>
    </pairpot>
  </hamiltonian>
  <qmc method="wf_train" move="pbyp" checkpoint="1">
    <training objective="energy" optimizer="adam">
      <parameter name="iterations">2</parameter><parameter name="learning_rate">0.0001</parameter>
      <parameter name="parameter_chunk_size">4</parameter>
      <parameter name="legacy_maximum_parameters">64</parameter>
      <parameter name="legacy_derivative_scratch_bytes">65536</parameter>
      <parameter name="checkpoint_interval">1</parameter><parameter name="line_search">off</parameter>
    </training>
    <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
    <parameter name="blocks">2</parameter><parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
    <parameter name="timestep">0.0001</parameter><parameter name="usedrift">no</parameter>
    <inference interval="1" last="yes" move="pbyp">
      <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
      <parameter name="blocks">1</parameter><parameter name="steps">1</parameter>
      <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
      <parameter name="timestep">0.0001</parameter><parameter name="usedrift">no</parameter>
    </inference>
  </qmc>
</simulation>
