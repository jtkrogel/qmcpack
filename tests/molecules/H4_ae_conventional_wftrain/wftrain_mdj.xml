<?xml version="1.0"?>
<simulation>
  <project id="h4_conventional_mdj" series="0"><parameter name="driver_version">batch</parameter></project>
  <random seed="81357"/>
  <!-- Same tiny H4-derived fixed-orbital model as the adapter/binding unit gate.
       STO-3G and orbital coefficients originate in H4_ae/H4.wfs.xml.
       Linear test geometry/positions and small J2 coefficients are explicit.
       CI0 is fixed; CI1 starts exactly at zero to exercise coefficient-safe APIs. -->
  <particleset name="ion0" size="4">
    <group name="H"><parameter name="charge">1</parameter><parameter name="valence">1</parameter>
      <parameter name="atomicnumber">1</parameter></group>
    <attrib name="position" datatype="posArray">0 0 -1.5  0 0 -0.5  0 0 0.5  0 0 1.5</attrib>
  </particleset>
  <particleset name="e">
    <group name="u" size="2"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
      <attrib name="position" datatype="posArray">0.3 0.2 -1.1  -0.2 0.4 0.8</attrib></group>
    <group name="d" size="2"><parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
      <attrib name="position" datatype="posArray">0.1 -0.3 -0.4  -0.4 -0.2 1.3</attrib></group>
  </particleset>
  <wavefunction name="psi0" target="e" print_parameters="no">
    <sposet_collection type="MolecularOrbital" name="LCAOBSet" transform="yes" source="ion0">
      <basisset name="LCAOBSet">
        <atomicBasisSet name="Gaussian" angular="cartesian" type="Gaussian" elementType="H" normalized="no">
          <grid type="log" ri="1.e-6" rf="1.e2" npts="1001"/>
          <basisGroup rid="H00" n="0" l="0" type="Gaussian">
            <radfunc exponent="3.4252509" contraction="0.154328967295"/>
            <radfunc exponent="0.6239137" contraction="0.535328142282"/>
            <radfunc exponent="0.1688554" contraction="0.444634542185"/>
          </basisGroup>
        </atomicBasisSet>
      </basisset>
      <sposet name="spo" basisset="LCAOBSet" size="3" optimize="no">
        <occupation mode="ground"/>
        <coefficient size="4" id="fixed_orbitals">
           0.504668 0.450114 0.358423 0.126449
          -0.240452 -0.320413 0.466777 0.703549
           0.088008 -0.504842 0.807522 -0.719301
           1.033235 -0.877213 -0.390492 0.212318
        </coefficient>
      </sposet>
    </sposet_collection>
    <determinantset>
      <multideterminant optimize="yes" spo_0="spo" spo_1="spo" algorithm="precomputed_table_method">
        <detlist size="2" type="DETS" nc0="0" nc1="0" ne0="2" ne1="2" nstates="3" cutoff="0">
          <ci id="CI0" coeff="0.6" occ0="110" occ1="110"/>
          <ci id="CI1" coeff="0" occ0="101" occ1="101"/>
        </detlist>
      </multideterminant>
    </determinantset>
    <jastrow name="J2" type="Two-Body" function="Bspline" print="yes">
      <correlation rcut="4" size="4" speciesA="u" speciesB="u">
        <coefficients id="uu" type="Array" optimize="yes">0.04 -0.02 0.01 -0.005</coefficients>
      </correlation>
      <correlation rcut="4" size="4" speciesA="u" speciesB="d">
        <coefficients id="ud" type="Array" optimize="yes">0.12 -0.08 0.04 -0.01</coefficients>
      </correlation>
    </jastrow>
  </wavefunction>
  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e"/>
    <pairpot name="IonElec" type="coulomb" source="ion0" target="e"/>
    <constant name="IonIon" type="coulomb" source="ion0" target="ion0"/>
  </hamiltonian>
  <qmc method="wf_train" move="pbyp" checkpoint="1">
    <training objective="energy" optimizer="adam">
      <parameter name="iterations">2</parameter><parameter name="learning_rate">0.0001</parameter>
      <parameter name="parameter_chunk_size">4</parameter>
      <parameter name="legacy_maximum_parameters">64</parameter>
      <parameter name="legacy_derivative_scratch_bytes">65536</parameter>
      <parameter name="checkpoint_interval">1</parameter><parameter name="line_search">off</parameter>
    </training>
    <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
    <parameter name="blocks">2</parameter><parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
    <parameter name="timestep">0.0001</parameter><parameter name="usedrift">no</parameter>
    <inference interval="1" last="yes" move="pbyp">
      <parameter name="walkers_per_rank">2</parameter><parameter name="crowds">1</parameter>
      <parameter name="blocks">1</parameter><parameter name="steps">1</parameter>
      <parameter name="warmupsteps">0</parameter><parameter name="substeps">1</parameter>
      <parameter name="timestep">0.0001</parameter><parameter name="usedrift">no</parameter>
    </inference>
  </qmc>
</simulation>
