<?xml version="1.0"?>
<simulation>
  <project id="heg_conventional_sj" series="0">
    <parameter name="driver_version">batch</parameter>
  </project>
  <random seed="81357"/>
  <!-- Existing heg_14_gamma rs=5 closed-shell FreeOrbital/J2 model.
       Explicit 3D Ewald; no orbital file, ions, backflow or optimized SPO. -->
  <qmcsystem>
    <simulationcell>
      <parameter name="rs" condition="14">5</parameter>
      <parameter name="bconds">p p p</parameter>
      <parameter name="LR_dim_cutoff">6</parameter>
      <parameter name="LR_handler">ewald</parameter>
    </simulationcell>
  </qmcsystem>
  <particleset name="e" random="yes">
    <group name="u" size="7">
      <parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
    </group>
    <group name="d" size="7">
      <parameter name="charge">-1</parameter><parameter name="mass">1</parameter>
    </group>
  </particleset>
  <wavefunction name="psi0" target="e" print_parameters="no">
    <sposet_collection type="free">
      <sposet name="spo-ud" size="7" optimize="no" twist="0 0 0"/>
    </sposet_collection>
    <determinantset>
      <slaterdeterminant><determinant sposet="spo-ud"/><determinant sposet="spo-ud"/></slaterdeterminant>
    </determinantset>
    <jastrow name="J2" type="Two-Body" function="Bspline" optimize="yes">
      <correlation speciesA="u" speciesB="u" size="5">
        <coefficients id="uu" type="Array" optimize="yes">1.082858193 0.6653279375 0.4358910287 0.2243616172 0.1102948764</coefficients>
      </correlation>
      <correlation speciesA="u" speciesB="d" size="5">
        <coefficients id="ud" type="Array" optimize="yes">1.696171854 1.047722154 0.6275148566 0.3175982878 0.1446706214</coefficients>
      </correlation>
    </jastrow>
  </wavefunction>
  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e" gpu="no"/>
  </hamiltonian>
  <qmc method="wf_train" move="pbyp" checkpoint="1">
    <training objective="energy" optimizer="adam">
      <parameter name="iterations">2</parameter>
      <parameter name="learning_rate">0.0001</parameter>
      <parameter name="parameter_chunk_size">4</parameter>
      <parameter name="legacy_maximum_parameters">64</parameter>
      <parameter name="legacy_derivative_scratch_bytes">65536</parameter>
      <parameter name="checkpoint_interval">1</parameter>
      <parameter name="line_search">off</parameter>
    </training>
    <parameter name="walkers_per_rank">2</parameter>
    <parameter name="crowds">1</parameter>
    <parameter name="blocks">4</parameter>
    <parameter name="steps">1</parameter>
    <parameter name="warmupsteps">0</parameter>
    <parameter name="substeps">1</parameter>
    <parameter name="timestep">0.05</parameter>
    <parameter name="usedrift">no</parameter>
    <inference interval="1" last="yes" move="pbyp">
      <parameter name="walkers_per_rank">2</parameter>
      <parameter name="crowds">1</parameter>
      <parameter name="blocks">1</parameter>
      <parameter name="steps">1</parameter>
      <parameter name="warmupsteps">0</parameter>
      <parameter name="substeps">1</parameter>
      <parameter name="timestep">0.05</parameter>
      <parameter name="usedrift">no</parameter>
    </inference>
  </qmc>
</simulation>
